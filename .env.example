# ==============================================================
# WalletAI — Variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y reemplaza cada valor.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).
# ==============================================================

# --- PostgreSQL ---
POSTGRES_DB=walletia
POSTGRES_USER=walletia_prod
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE

# --- n8n: acceso público ---
N8N_HOST=api.tudominio.com
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://api.tudominio.com/

# --- n8n: seguridad ---
N8N_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE_32_CHARS
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CAMBIA_ESTA_CLAVE

# --- Zona horaria ---
GENERIC_TIMEZONE=America/Tijuana
TZ=America/Tijuana

# --- Cliente Expo (público por diseño, no es secreto) ---
EXPO_PUBLIC_API_URL=https://api.tudominio.com

# --- Proxy / SSL (si se implementa Nginx Proxy Manager) ---
DOMAIN=api.tudominio.com
SSL_ADMIN_EMAIL=devops@tudominio.com
