    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object(\n    'summary', (\n        SELECT json_build_object(\n            'total', SUM(amount),\n            'average', AVG(amount),\n            'count', COUNT(*),\n            'highest', MAX(amount)\n        )\n        FROM expenses\n    ),\n    'categories', (\n        SELECT json_agg(c)\n        FROM (\n            SELECT\n                category,\n                SUM(amount) AS total\n            FROM expenses\n            GROUP BY category\n            ORDER BY total DESC\n        ) c\n    ),\n    'monthly', (\n        SELECT json_agg(m)\n        FROM (\n            SELECT\n                TO_CHAR(created_at, 'Mon') AS month,\n                SUM(amount) AS total\n            FROM expenses\n            GROUP BY DATE_TRUNC('month', created_at), month\n            ORDER BY DATE_TRUNC('month', created_at)\n        ) m\n    )\n) AS statistics;",
        "options": {}
      },
